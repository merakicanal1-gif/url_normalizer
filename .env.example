# Porta onde a API escutará requisições
PORT=3000

# Interface de rede para vinculação do servidor
HOST=0.0.0.0

# Endpoint CDP WebSocket de conexão com a infraestrutura Browserless
# Para execução via docker-compose local, use: ws://browserless:3000
# Para desenvolvimento local puro apontando para um docker local, use: ws://localhost:3000
BROWSERLESS_URL=ws://localhost:3000

# Timeout máximo de carregamento e redirecionamento de páginas (em milissegundos)
TIMEOUT_MS=30000

# Ambiente de execução (development | production)
NODE_ENV=development

# ==============================================================================
# Configurações do BrowserProfile (Portabilidade de Navegação)
# ==============================================================================

# User-Agent utilizado nas requisições do navegador
BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Idioma (locale) configurado no navegador
BROWSER_LOCALE="pt-BR"

# Fuso horário (timezone) configurado no navegador
BROWSER_TIMEZONE="America/Sao_Paulo"

# Dimensões da tela do navegador (Viewport)
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# Cabeçalhos HTTP extras enviados pelo navegador em formato JSON (Opcional)
# BROWSER_HEADERS='{"DNT":"1","Sec-GPC":"1"}'

# Caminho absoluto para arquivo de estado exportado ou JSON stringificado (Opcional)
# BROWSER_STORAGE_STATE=""
