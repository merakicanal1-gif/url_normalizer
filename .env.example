# ==============================================================================
# Configurações do Servidor
# ==============================================================================
PORT=3000
HOST=0.0.0.0
TIMEOUT_MS=30000
NODE_ENV=development

# ==============================================================================
# Configurações do Navegador Persistente Local
# ==============================================================================
BROWSER_HEADLESS=false
BROWSER_DATA_DIR="./data/browser"

# Fase 3 - Conexão CDP
BROWSER_MODE=cdp
CDP_ENDPOINT=http://127.0.0.1:9222
AUTO_START_BROWSER=false

# Diretórios de saída para artefatos de depuração
DOWNLOADS_DIR="./data/downloads"
SCREENSHOTS_DIR="./data/screenshots"
TRACES_DIR="./data/traces"
VIDEOS_DIR="./data/videos"

# ==============================================================================
# Customizações do Browser
# ==============================================================================
BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
BROWSER_LOCALE="pt-BR"
BROWSER_TIMEZONE="America/Sao_Paulo"
BROWSER_VIEWPORT_WIDTH=1366
BROWSER_VIEWPORT_HEIGHT=768
LOG_LEVEL=info
