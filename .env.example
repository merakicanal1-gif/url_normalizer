# ==============================================================================
# Configurações do Servidor
# ==============================================================================
PORT=3000
HOST=0.0.0.0
TIMEOUT_MS=30000
NODE_ENV=development

# ==============================================================================
# Configurações de Segurança e Criptografia
# ==============================================================================

# Chave simétrica utilizada para criptografar o estado da sessão (storageState.enc)
# Formato exigido: 'keyId:segredo_criptográfico'
# Múltiplas chaves (para rotação) podem ser informadas separando-as por vírgula:
#   SESSION_ENCRYPTION_KEY="keyId1:secret1,keyId2:secret2"
#
# IMPORTANTE:
# - Em produção (NODE_ENV=production), a presença de uma chave válida é OBRIGATÓRIA. O bootstrap falhará se estiver ausente ou insegura.
# - A mesma chave configurada no momento da gravação deve permanecer ativa para ler os perfis salvos.
# - A perda ou alteração desta chave sem manter a chave antiga no chaveiro inviabiliza a descriptografia do storageState.enc.
SESSION_ENCRYPTION_KEY="default:dev-fallback-key-change-this-in-prod"

# ==============================================================================
# Configurações do Navegador (Playwright Local)
# ==============================================================================

# Habilita ou desabilita o navegador interativo headful (usado para login manual)
# Valores: true | false
# Em produção/VPS, configure como 'false' para economizar recursos e evitar falhas de inicialização sem X11.
INTERACTIVE_BROWSER_ENABLED=true

# Diretório base de armazenamento de perfis e cookies de sessões
# Padrão local: './data/profiles' (se omitido)
# Padrão Docker/Compose: '/app/data/profiles'
SESSION_STORAGE_DIR="./data/profiles"

# ==============================================================================
# Customizações do Profile (Portabilidade de Navegação)
# ==============================================================================
BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
BROWSER_LOCALE="pt-BR"
BROWSER_TIMEZONE="America/Sao_Paulo"
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
